# Python virtualenv for the pdf skill in the docs preset (77 MB).
# Rebuild it from docs/skills/pdf/LOCAL-SETUP.md rather than committing it.
docs/venv/
**/venv/
**/__pycache__/
*.py[cod]
.pytest_cache/

# anything else transient
*.log
*.tmp

# Backups sync-profile.mjs takes before it overwrites a profile file. They hold whatever local edits
# the machine had, which is the state the repository is meant to replace, so they are noise in
# history rather than content.
.backup-*/
*.bak
